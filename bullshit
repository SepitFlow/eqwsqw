		TextSize = 9,
		Font = Enum.Font.GothamBold,
		TextColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 5,
	}, chatBtn)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, chatBadge)

	-- Separate top-level window: it remains visible when the Fly dropdown is collapsed
	-- and is not coupled to the flight ON/OFF state.
	local viewport = camera.ViewportSize
