------------------------------------------------------------------
-- TOOLS: INVISIBLE (seat-based reference method)
------------------------------------------------------------------
-- The reference routine's useful portion is the temporary move + hidden seat
-- + weld. The speed boost, sound, notifications, and separate GUI are omitted.
-- HumanoidRootPart is used as the stable R6/R15 anchor, but it is never hidden
-- or modified. Other body parts use LocalTransparencyModifier for local rendering.
local invisOriginal = setmetatable({}, { __mode = "k" })
local invisConn = nil
local invisSeat = nil
local invisWeld = nil
local invisCharacter = nil
local invisBusy = false
local invisWanted = false

local function hideInvisibleInstance(d)
	local prop, hiddenValue
	if d:IsA("BasePart") then
		if d.Name == "HumanoidRootPart" then
			return -- never fade or overwrite the HumanoidRootPart
		end
		prop, hiddenValue = "LocalTransparencyModifier", 1
	elseif d:IsA("Decal") or d:IsA("Texture") then
		prop, hiddenValue = "Transparency", 1
	elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") then
		prop, hiddenValue = "Enabled", false
	else
		return
	end

	if invisOriginal[d] == nil then
		invisOriginal[d] = { prop, d[prop] }
	end
	d[prop] = hiddenValue
end

local function restoreInvisibleAppearance()
	if invisConn then
		invisConn:Disconnect()
		invisConn = nil
	end

	for inst, saved in pairs(invisOriginal) do
		if inst and inst.Parent then
			pcall(function()
				inst[saved[1]] = saved[2]
			end)
		end
	end
	table.clear(invisOriginal)
end

local function removeInvisibleSeat()
	if invisWeld then
		pcall(function() invisWeld:Destroy() end)
		invisWeld = nil
	end
	if invisSeat then
		pcall(function() invisSeat:Destroy() end)
		invisSeat = nil
	end
	invisCharacter = nil
end

local function applyInvisibleAppearance(character)
	for _, d in ipairs(character:GetDescendants()) do
		hideInvisibleInstance(d)
	end
	if invisConn then invisConn:Disconnect() end
	invisConn = character.DescendantAdded:Connect(function(d)
		if invisibleOn and invisCharacter == character then
			pcall(hideInvisibleInstance, d)
		end
	end)
end

local function setInvisible(state)
	state = state == true
	invisWanted = state
	if invisBusy then return invisibleOn end
	if state == invisibleOn then return invisibleOn end
	invisBusy = true

	if state then
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not (character and humanoid and root and root:IsA("BasePart") and humanoid.Health > 0) then
			warn("FlightHub invisibility: character or HumanoidRootPart is not ready")
			invisWanted = false
			invisBusy = false
			return false
		end

		local originalPivot = character:GetPivot()
		local originalRootCFrame = root.CFrame
		local originalLinearVelocity = root.AssemblyLinearVelocity
		local originalAngularVelocity = root.AssemblyAngularVelocity
		local ok, err = xpcall(function()
			-- Briefly move away, as in the supplied reference, then attach a hidden
			-- seat to the root and move that welded assembly back to its start point.
			character:PivotTo(CFrame.new(CONFIG.INVISIBILITY_POSITION) * originalPivot.Rotation)
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			task.wait(0.15)

			local seat = Instance.new("Seat")
			seat.Name = "FlightHub_InvisSeat_" .. tostring(player.UserId)
			seat.Size = Vector3.new(2, 0.2, 2)
			seat.Anchored = false
			seat.CanCollide = false
			seat.CanTouch = false
			seat.CanQuery = false
			seat.Massless = true
			seat.Transparency = 1
			seat.CFrame = root.CFrame
			seat.Parent = workspace
			invisSeat = seat
			invisCharacter = character

			local weld = Instance.new("Weld")
			weld.Name = "FlightHub_InvisWeld"
			weld.Part0 = seat
			weld.Part1 = root
			weld.C0 = CFrame.identity
			weld.C1 = CFrame.identity
			weld.Parent = seat
			invisWeld = weld

			RunService.Heartbeat:Wait()
			seat.CFrame = originalRootCFrame
			RunService.Heartbeat:Wait()

			if not (character.Parent and root.Parent and seat.Parent and weld.Parent) then
				error("character changed during invisibility setup")
			end

			root.AssemblyLinearVelocity = originalLinearVelocity
			root.AssemblyAngularVelocity = originalAngularVelocity
			invisibleOn = true
			applyInvisibleAppearance(character)
		end, debug.traceback)

		if not ok then
			invisibleOn = false
			invisWanted = false
			removeInvisibleSeat()
			restoreInvisibleAppearance()
			if character.Parent then
				pcall(function()
					character:PivotTo(originalPivot)
					local currentRoot = character:FindFirstChild("HumanoidRootPart")
					if currentRoot and currentRoot:IsA("BasePart") then
						currentRoot.AssemblyLinearVelocity = originalLinearVelocity
						currentRoot.AssemblyAngularVelocity = originalAngularVelocity
					end
				end)
			end
			warn("FlightHub invisibility setup failed: " .. tostring(err))
		end
	else
		invisibleOn = false
		restoreInvisibleAppearance()
		removeInvisibleSeat()
	end

	invisBusy = false
	-- Honor a toggle pressed while the seat transition was yielding.
	if invisibleOn ~= invisWanted then
		return setInvisible(invisWanted)
	end
	return invisibleOn
end

