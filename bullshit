local viewConn = nil

local function stopViewing(skipCamera)
	local was = viewing
	viewing = false
	if viewConn then
		viewConn:Disconnect()
		viewConn = nil
	end
	if not skipCamera then
		local char = player.Character
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")
		if humanoid then camera.CameraSubject = humanoid end
		if was then notify("Stopped viewing", "info", 1.8) end
	end
	setBtnText(viewBtn, "View")
end

local function startViewing()
	if not targetPlayer then
		flash(viewBtn, "pick player")
		notify("Pick a player first", "warn", 2)
		return
	end
	local char = targetPlayer.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		flash(viewBtn, "not loaded")
		notify(targetPlayer.DisplayName .. " isn't loaded yet", "warn", 2)
		return
	end

	camera.CameraSubject = humanoid
	viewing = true
	if viewConn then viewConn:Disconnect() end
	viewConn = targetPlayer.CharacterAdded:Connect(function(newChar)
		local h = newChar:WaitForChild("Humanoid", 5)
		if viewing and h then
			camera.CameraSubject = h
		end
	end)
	setBtnText(viewBtn, "Unview")
	notify("Viewing " .. targetPlayer.DisplayName, "good", 2)
end

local function selectPlayer(p)
	targetPlayer = p
	setBtnText(playerDropBtn, p and ("Player: " .. p.DisplayName) or "Player: none")
	playerDropOpen = false
	if viewing then
		if p then startViewing() else stopViewing() end
	end
	applyPlayerList()
end

local function refreshPlayers()
	for _, child in ipairs(playerList:GetChildren()) do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end

	local count = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			count += 1
			local b = makeButton(playerList, p.DisplayName, UDim2.new(1, -4, 0, 20), function()
				selectPlayer(p)
			end)
			b.LayoutOrder = count
			leftAlign(b)
		end
	end
	if count == 0 then
		new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 20),
			BackgroundTransparency = 1,
			Text = "no other players",
			TextSize = 11,
			Font = Enum.Font.Gotham,
			TextColor3 = GRAY,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, playerList)
	end
	playerCount = count

	if targetPlayer and not targetPlayer.Parent then
		selectPlayer(nil)
	else
		applyPlayerList()
	end
end

local function goToPlayer()
	if not targetPlayer then
		flash(goBtn, "pick player")
		notify("Pick a player first", "warn", 2)
		return
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local tRoot = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	if not tRoot then
		flash(goBtn, "not loaded")
		notify(targetPlayer.DisplayName .. " isn't loaded yet", "warn", 2)
		return
	end
	root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 4)
	root.AssemblyLinearVelocity = Vector3.zero
	notify("Teleported to " .. targetPlayer.DisplayName, "good", 2)
end

goBtn.MouseButton1Click:Connect(goToPlayer)
viewBtn.MouseButton1Click:Connect(function()
	if viewing then stopViewing() else startViewing() end
end)
playerDropBtn.MouseButton1Click:Connect(function()
	playerDropOpen = not playerDropOpen
	applyPlayerList()
end)

