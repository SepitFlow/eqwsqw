local function flash(button, msg)
	local orig = button:GetAttribute("orig") or button.Text
	button.Text = msg
	task.delay(1.2, function()
		if button.Text == msg then
			button.Text = orig
		end
	end)
end

local function makeChip(parent, str, order, callback, startActive)
	local b = new("TextButton", {
		LayoutOrder = order,
		Size = UDim2.fromOffset(80, 20),
		Text = str,
		TextSize = 11,
		Font = Enum.Font.GothamMedium,
		TextColor3 = WHITE,
		BackgroundColor3 = BTN,
		AutoButtonColor = false,
	}, parent)
	new("UICorner", { CornerRadius = UDim.new(0, 6) }, b)

	local active = startActive == true
	local info = TweenInfo.new(0.12)
	local function paint(hover)
		TweenService:Create(b, info, {
			BackgroundColor3 = active and ACCENT or (hover and BTN_HOVER or BTN),
			TextColor3 = active and DARK or WHITE,
		}):Play()
	end
	if active then
		b.BackgroundColor3 = ACCENT
		b.TextColor3 = DARK
	end
	b.MouseEnter:Connect(function() paint(true) end)
	b.MouseLeave:Connect(function() paint(false) end)
	b.MouseButton1Click:Connect(function()
		local result = callback(not active)
		if result == nil then result = not active end
		active = result
		paint(true)
	end)
	return b
end

