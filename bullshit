local function freecamStep(dt)
	local rot = CFrame.fromOrientation(freecam.pitch, freecam.yaw, 0)
	local move = Vector3.zero

	if not UserInputService:GetFocusedTextBox() then
		local function down(key)
			return UserInputService:IsKeyDown(key)
		end
		if down(Enum.KeyCode.W) then move += rot.LookVector end
		if down(Enum.KeyCode.S) then move -= rot.LookVector end
		if down(Enum.KeyCode.D) then move += rot.RightVector end
		if down(Enum.KeyCode.A) then move -= rot.RightVector end
		if down(Enum.KeyCode.E) then move += Vector3.yAxis end
		if down(Enum.KeyCode.Q) then move -= Vector3.yAxis end
	end

	if move.Magnitude > 0 then
		freecam.pos += move.Unit * speedSetting * dt
	end
	camera.CFrame = CFrame.new(freecam.pos) * rot
end

local function setFreecam(state)
	if state == freecam.on then return state end

	if state then
		local pitch, yaw = camera.CFrame:ToOrientation()
		freecam.pitch, freecam.yaw = pitch, yaw
		freecam.pos = camera.CFrame.Position
		camera.CameraType = Enum.CameraType.Scriptable
		if controls then controls:Disable() end
		freecam.on = true
		RunService:BindToRenderStep("FlightFreecam", Enum.RenderPriority.Camera.Value + 1, freecamStep)
		notify("Freecam on (WASD + Q/E, hold right mouse to look)", "good", 3)
	else
		RunService:UnbindFromRenderStep("FlightFreecam")
		freecam.on = false
		freecam.looking = false
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		camera.CameraType = Enum.CameraType.Custom
		if controls then controls:Enable() end
		notify("Freecam off", "info", 1.8)
	end
	return freecam.on
end

bind(UserInputService.InputBegan, function(input, processed)
	if freecam.on and not processed and input.UserInputType == Enum.UserInputType.MouseButton2 then
		freecam.looking = true
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
	end
end)
bind(UserInputService.InputEnded, function(input)
	if freecam.on and input.UserInputType == Enum.UserInputType.MouseButton2 then
		freecam.looking = false
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
end)
bind(UserInputService.InputChanged, function(input)
	if freecam.on and freecam.looking and input.UserInputType == Enum.UserInputType.MouseMovement then
		freecam.yaw -= input.Delta.X * CONFIG.FREECAM_SENSITIVITY
		freecam.pitch = math.clamp(freecam.pitch - input.Delta.Y * CONFIG.FREECAM_SENSITIVITY, -1.5, 1.5)
	end
end)

