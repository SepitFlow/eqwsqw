local noclipOriginal = setmetatable({}, { __mode = "k" })

local function setNoclip(state)
	noclipOn = state
	if not state then
		for part, canCollide in pairs(noclipOriginal) do
			if part.Parent then
				part.CanCollide = canCollide
			end
		end
		table.clear(noclipOriginal)
	end
	notify(state and "Noclip on" or "Noclip off", state and "good" or "info", 1.8)
	return state
end

bind(RunService.Stepped, function()
	if not noclipOn then return end
	local char = player.Character
	if not char then return end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then
			if noclipOriginal[d] == nil then
				noclipOriginal[d] = d.CanCollide
			end
			d.CanCollide = false
		end
	end
end)

