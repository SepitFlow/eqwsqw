bind(RunService.Heartbeat, function(dt)
	if not flying or not rig then return end
	if not rig.root.Parent then
		flying = false
		rig = nil
		updateToggleUi()
		return
	end

	local camCF = camera.CFrame
	local look = camCF.LookVector
	local frozen = freecam.on

	local moveVec = Vector3.zero
	if not frozen and controls then
		moveVec = controls:GetMoveVector()
	end

	local dir = camCF:VectorToWorldSpace(Vector3.new(moveVec.X, 0, moveVec.Z))
	local hasInput = dir.Magnitude > 0.05
	if hasInput then
		dir = dir.Magnitude > 1 and dir.Unit or dir
	else
		dir = Vector3.zero
	end
	local alpha = 1 - math.exp(-CONFIG.MOVE_SMOOTHING * dt)
	rig.vel = rig.vel:Lerp(dir * speedSetting, alpha)
	rig.lv.VectorVelocity = rig.vel

	if not frozen then
		local facing = hasInput and dir.Unit or look
		local flat = Vector3.new(facing.X, 0, facing.Z)
		if flat.Magnitude > 0.01 then
			rig.lastFlat = flat.Unit
		end
		local pitch = math.asin(math.clamp(facing.Y, -1, 1)) * CONFIG.LOOK_STRENGTH
		rig.ao.Responsiveness = hasInput and CONFIG.MOVE_TURN_SMOOTHING or CONFIG.LOOK_SMOOTHING
		rig.ao.CFrame = CFrame.lookAt(Vector3.zero, rig.lastFlat) * CFrame.Angles(pitch, 0, 0)
	end

	for _, track in ipairs(rig.animator:GetPlayingAnimationTracks()) do
		if track ~= rig.idle and track ~= rig.move then
			track:Stop(0.25)
		end
	end
	local want = hasInput and rig.move or rig.idle
	if rig.current ~= want then
		if rig.current then rig.current:Stop(0.3) end
		want:Play(0.3)
		rig.current = want
	end
end)

