-- GLOBAL CHAT (independent floating window; toggle remains inside the Fly dropdown; not encrypted)
------------------------------------------------------------------
local chat = { open = false, unread = 0, seen = {}, order = 0, lastSend = 0 }

if CONFIG.CHAT_ENABLED then
	local function httpRequest(opts)
		for _, getter in ipairs({
			function() return request end,
			function() return syn and syn.request end,
			function() return http_request end,
			function() return http and http.request end,
		}) do
			local ok, fn = pcall(getter)
			if ok and type(fn) == "function" then
				local ok2, res = pcall(fn, opts)
				if ok2 and type(res) == "table" then
					local status = tonumber(res.StatusCode or res.status_code or res.Status) or ((res.Success == true or res.success == true) and 200 or 0)
					return { status = status, body = tostring(res.Body or res.body or ""), success = status >= 200 and status < 300 }
				end
			end
		end
		local ok, res = pcall(function() return Http:RequestAsync(opts) end)
		if ok and type(res) == "table" then
			return { status = res.StatusCode, body = res.Body, success = res.StatusCode >= 200 and res.StatusCode < 300 }
		end
		return nil, "No HTTP function available in this executor"
	end

	local chatServerBase = tostring(CONFIG.CHAT_SERVER_URL or ""):gsub("/+$", "")
	local chatConfigured = chatServerBase:match("^https://[%w%.%-]+$") ~= nil
		and not chatServerBase:find("REPLACE", 1, true)

	local function authHeaders(contentType)
		local headers = { ["Authorization"] = "Bearer " .. tostring(CONFIG.CHAT_ACCESS_TOKEN) }
		if contentType then headers["Content-Type"] = contentType end
		return headers
	end

	local function responseError(res)
		local detail = ""
		if res.body and res.body ~= "" then
			local ok, decoded = pcall(function() return Http:JSONDecode(res.body) end)
			if ok and type(decoded) == "table" and type(decoded.error) == "string" then
				detail = ": " .. decoded.error
			end
		end
		return "HTTP " .. tostring(res.status) .. detail
	end

	local function relayPost(payload)
		if not chatConfigured then return nil, "Set CHAT_SERVER_URL to your current HTTPS tunnel URL" end
		local res, err = httpRequest({
			Url = chatServerBase .. "/v1/send", Method = "POST",
			Headers = authHeaders("application/json"), Body = Http:JSONEncode(payload),
		})
		if not res then return nil, err end
		if not res.success then return nil, responseError(res) end
		return true
	end

	-- Long-poll endpoint: the server holds this request until a new message arrives
	-- (or its 20-second safety timeout expires). There is no fixed 4-second poll delay.
	local function relayPoll(since)
		if not chatConfigured then return nil, "Set CHAT_SERVER_URL to your current HTTPS tunnel URL" end
		local res, err = httpRequest({
			Url = chatServerBase .. "/v1/poll?since=" .. tostring(since), Method = "GET",
			Headers = authHeaders(),
		})
		if not res then return nil, err end
		if not res.success then return nil, responseError(res) end
		local ok, data = pcall(function() return Http:JSONDecode(res.body) end)
		if not ok or type(data) ~= "table" or type(data.messages) ~= "table" then
			return nil, "Invalid response from chat server"
		end
		return data.messages, tonumber(data.cursor) or tonumber(since) or 0
	end

	local CHAT_W = CONFIG.CHAT_WIDTH

	-- Chat toggle stays in the Fly dropdown, but the chat window itself is independent.
	new("Frame", {
		LayoutOrder = 11,
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.9,
		BorderSizePixel = 0,
	}, dropPanel)

	chatBtn = makeButton(dropPanel, "💬  Global Chat  ▼", UDim2.new(1, 0, 0, 22))
	chatBtn.LayoutOrder = 12
	leftAlign(chatBtn)
	chatBadge = new("TextLabel", {
