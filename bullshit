	local function updateBadge()
		local unread = chat.unread
		chatBadge.Visible = unread > 0
		chatBadge.Text = unread > 9 and "9+" or tostring(unread)
		pillChatBadge.Visible = unread > 0
		pillChatBadge.Text = unread > 9 and "+9" or ("+" .. tostring(unread))
	end

	local function setChatOpen(v)
		chat.open = v
		chatSection.Visible = v
		chatBtn.Text = v and "💬  Global Chat  ▲" or "💬  Global Chat  ▼"
		if v then
			chat.unread = 0
			updateBadge()
			task.defer(function() scroll.CanvasPosition = Vector2.new(0, 1e6) end)
		end
	end

	chatBtn.MouseButton1Click:Connect(function() setChatOpen(not chat.open) end)
	closeChat.MouseButton1Click:Connect(function() setChatOpen(false) end)

	-- Drag the chat independently with the title bar (mouse or touch).
	local chatDragging = false
	local chatDragStart = nil
	local chatStartPosition = nil
	chatDragBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			chatDragging = true
			chatDragStart = input.Position
			chatStartPosition = chatSection.Position
		end
	end)
	bind(UserInputService.InputChanged, function(input)
		if chatDragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - chatDragStart
			local view = camera.ViewportSize
			local x = math.clamp(chatStartPosition.X.Offset + delta.X, 0, math.max(0, view.X - CHAT_W))
			local y = math.clamp(chatStartPosition.Y.Offset + delta.Y, 0, math.max(0, view.Y - CHAT_H))
			chatSection.Position = UDim2.fromOffset(x, y)
		end
	end)
	bind(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			chatDragging = false
		end
	end)

	local function addLine(text, color)
		chat.order += 1
		new("TextLabel", {
			Text = text, LayoutOrder = chat.order, BackgroundTransparency = 1, TextColor3 = color or WHITE,
			Font = Enum.Font.Gotham, TextSize = 14, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		}, scroll)
		local kids = {}
		for _, c in ipairs(scroll:GetChildren()) do
			if c:IsA("TextLabel") then kids[#kids + 1] = c end
		end
		if #kids > CONFIG.CHAT_MAX_LINES then
			table.sort(kids, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
			kids[1]:Destroy()
		end
		task.defer(function() scroll.CanvasPosition = Vector2.new(0, 1e6) end)
	end

	local function send()
		if not chatConfigured then
			addLine("Set CHAT_SERVER_URL in the script to your current HTTPS tunnel URL.", BAD)
			return
		end
		local text = input.Text:match("^%s*(.-)%s*$") or ""
		if text == "" then return end
		if #text > CONFIG.CHAT_MAX_CHARS then
			addLine("Message too long (max " .. CONFIG.CHAT_MAX_CHARS .. ").", BAD)
			return
		end
		if os.clock() - chat.lastSend < 1 then return end
		chat.lastSend = os.clock()
		input.Text = ""

		local nonce = (Http:GenerateGUID(false):gsub("-", ""))
		chat.seen[nonce] = true
		addLine(player.DisplayName .. ": " .. text, Color3.fromRGB(202, 180, 255))
		task.spawn(function()
			local ok, err = relayPost({ n = nonce, u = player.DisplayName:sub(1, 24), t = text })
			if not ok then
				addLine("Send failed: " .. tostring(err), BAD)
				notify("Chat send failed: " .. tostring(err), "chat", 3)
			end
		end)
	end
	sendBtn.MouseButton1Click:Connect(send)
	input.FocusLost:Connect(function(enter) if enter then send() end end)

	if not chatConfigured then
		addLine("Chat setup needed: set CHAT_SERVER_URL to the HTTPS URL shown by Cloudflare.", WARN)
	else
		task.spawn(function()
			local since = 0
			local backoff = CONFIG.CHAT_RETRY_MIN
			local lastErr = nil
			while alive do
				local msgs, cursorOrErr = relayPoll(since)
				if msgs then
					backoff, lastErr = CONFIG.CHAT_RETRY_MIN, nil
					for _, rec in ipairs(msgs) do
						if type(rec) == "table" then
							local messageId = tonumber(rec.id)
							if messageId and messageId > since then since = messageId end
							if type(rec.t) == "string" and type(rec.n) == "string" and not chat.seen[rec.n] then
								chat.seen[rec.n] = true
								local who = tostring(rec.u or "Someone"):sub(1, 24)
								local body = rec.t:sub(1, CONFIG.CHAT_MAX_CHARS)
								addLine(who .. ": " .. body)
								if not chat.open then
									chat.unread += 1
									updateBadge()
								end
							end
						end
					end
					local serverCursor = tonumber(cursorOrErr)
					if serverCursor and serverCursor > since then since = serverCursor end
				else
					local err = tostring(cursorOrErr)
					if err:find("No HTTP", 1, true) then
						addLine("Chat needs an executor with HTTP request support.", BAD)
						notify("Global chat unavailable: no HTTP function", "chat", 4)
						return
					end
					if err ~= lastErr then
						lastErr = err
						addLine("Chat server problem: " .. err .. " (retrying)", BAD)
					end
					task.wait(backoff)
					backoff = math.min(backoff * 2, CONFIG.CHAT_RETRY_MAX)
				end
			end
		end)
	end
end

------------------------------------------------------------------
-- RESPAWN
------------------------------------------------------------------
bind(player.CharacterAdded, function(char)
	-- Re-run the one-time legacy cleanup for each newly spawned character.
	task.spawn(removeLegacyFlyObjects, char)
	removeLegacyFlyControllers()

	flying = false
	rig = nil
	updateToggleUi()

	if viewing then
		stopViewing(true)
		notify("Respawned: stopped viewing", "info", 2)
	end
	if invisWanted then
		-- The old character and its seat are being replaced. Clean the old rig,
		-- then reapply only if the user has not switched invisibility off.
		invisibleOn = false
		restoreInvisibleAppearance()
		removeInvisibleSeat()
		task.spawn(function()
			local humanoid = char:WaitForChild("Humanoid", 8)
			local root = char:WaitForChild("HumanoidRootPart", 8)
			if alive and invisWanted and humanoid and root then
				setInvisible(true)
			end
		end)
	end
end)

------------------------------------------------------------------
-- SHUTDOWN (runs when the script is executed again)
------------------------------------------------------------------
local function shutdown()
	if not alive then return end
	pcall(function() setFlying(false, true) end)
	pcall(function() if freecam.on then setFreecam(false) end end)
	pcall(function() if noclipOn then setNoclip(false) end end)
	pcall(function() if invisibleOn then setInvisible(false) end end)
	pcall(function() if viewing then stopViewing() end end)
	alive = false
	for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
	pcall(function() gui:Destroy() end)
	if store.FlightHub_Shutdown == shutdown then store.FlightHub_Shutdown = nil end
end
store.FlightHub_Shutdown = shutdown

notify("Flight hub loaded. Press F to fly.", "good", 3)
