local function buildRig()
	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root and humanoid.Health > 0) then
		return nil
	end

	local animator = humanoid:FindFirstChildOfClass("Animator") or new("Animator", {}, humanoid)

	local att = new("Attachment", { Name = "FlyAttachment" }, root)
	local lv = new("LinearVelocity", {
		Attachment0 = att,
		MaxForce = math.huge,
		VelocityConstraintMode = Enum.VelocityConstraintMode.Vector,
		RelativeTo = Enum.ActuatorRelativeTo.World,
		VectorVelocity = Vector3.zero,
	}, root)
	local ao = new("AlignOrientation", {
		Attachment0 = att,
		Mode = Enum.OrientationAlignmentMode.OneAttachment,
		MaxTorque = math.huge,
		Responsiveness = CONFIG.LOOK_SMOOTHING,
		RigidityEnabled = false,
		CFrame = root.CFrame.Rotation,
	}, root)

	local function load(id)
		local anim = new("Animation", { AnimationId = id }, nil)
		local track = animator:LoadAnimation(anim)
		track.Priority = Enum.AnimationPriority.Action
		track.Looped = true
		return track
	end

	local startLook = root.CFrame.LookVector
	local startFlat = Vector3.new(startLook.X, 0, startLook.Z)

	local newRig = {
		humanoid = humanoid,
		root = root,
		animator = animator,
		animate = char:FindFirstChild("Animate"),
		att = att,
		lv = lv,
		ao = ao,
		idle = load(CONFIG.IDLE_ANIM),
		move = load(CONFIG.MOVE_ANIM),
		current = nil,
		vel = Vector3.zero,
		lastFlat = startFlat.Magnitude > 0.01 and startFlat.Unit or Vector3.new(0, 0, -1),
	}

	humanoid.Died:Connect(function()
		if rig == newRig then
			flying = false
			rig = nil
			updateToggleUi()
			notify("Flight stopped: you died", "bad")
		end
	end)

	return newRig
end

local function setFlying(state, silent)
	if state == flying then return end

	if state then
		local r = buildRig()
		if not r then
			notify("Can't fly right now (no character)", "warn")
			return
		end
		rig = r
		if rig.animate then rig.animate.Disabled = true end
		rig.humanoid.PlatformStand = true
		flying = true
		if not silent then notify("Flight enabled", "good", 1.8) end
	else
		flying = false
		local r = rig
		rig = nil
		if r then
			r.idle:Stop(0.2)
			r.move:Stop(0.2)
			r.lv:Destroy()
			r.ao:Destroy()
			r.att:Destroy()
			if r.root.Parent then
				if r.animate then r.animate.Disabled = false end
				r.humanoid.PlatformStand = false
				if r.humanoid.Health > 0 then
					r.humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
				end
			end
		end
		if not silent then notify("Flight disabled", "info", 1.8) end
	end
	updateToggleUi()
end

