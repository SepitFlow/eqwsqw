-- This removes only the specifically named legacy instances from the
-- local character and the two named ReplicatedFirst folders. It does not
-- touch FlightHub's own FlyAttachment / LinearVelocity / AlignOrientation.
local function removeLegacyFlyObjects(character)
    if not character then return end

    local root = character:FindFirstChild("HumanoidRootPart")
        or character:WaitForChild("HumanoidRootPart", 10)
    if not root then return end

    for _, objectName in ipairs({ "flyVel", "flyGyro" }) do
        local object = root:FindFirstChild(objectName)
        if object then
            pcall(function() object:Destroy() end)
        end
    end
end

local function removeLegacyFlyControllers()
    for _, folderName in ipairs({ "Controllers", "Bootstrapper" }) do
        local folder = ReplicatedFirst:FindFirstChild(folderName)
        local controller = folder and folder:FindFirstChild("FlyController")
        if controller then
            pcall(function() controller:Destroy() end)
        end
    end
end

