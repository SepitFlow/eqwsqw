local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end

local function hoverable(button, normal, hover)
	local info = TweenInfo.new(0.12)
	button.MouseEnter:Connect(function()
		TweenService:Create(button, info, { BackgroundColor3 = hover }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, info, { BackgroundColor3 = normal }):Play()
	end)
end

local function makeButton(parent, str, size, onClick)
	local b = new("TextButton", {
		Size = size,
		Text = str,
		TextSize = 11,
		Font = Enum.Font.GothamMedium,
		TextColor3 = WHITE,
		BackgroundColor3 = BTN,
		AutoButtonColor = false,
	}, parent)
	b:SetAttribute("orig", str)
	new("UICorner", { CornerRadius = UDim.new(0, 6) }, b)
	hoverable(b, BTN, BTN_HOVER)
	if onClick then
		b.MouseButton1Click:Connect(onClick)
	end
	return b
end

